; Engine configuration file.
; RIFT RUMBLE — prueba de concepto (Fase 1)

config_version=5

[application]

config/name="RIFT RUMBLE"
config/description="Tower defense isométrico 2.5D — prueba de concepto"
run/main_scene="res://src/view/main.tscn"
